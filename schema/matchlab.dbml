enum user_account_status {
	active
	blocked
	deleted
}

enum system_role_code {
	client
	moderator
	administrator
}

enum project_status {
	draft
	pending_moderation
	recruiting
	active
	completed
	cancelled
	rejected
	hidden
}

enum project_member_status {
	active
	left
	removed
}

enum join_request_type {
	application
	invitation
}

enum join_request_status {
	pending
	accepted
	rejected
	cancelled
}

enum support_ticket_type {
	support
	complaint
	moderation
}

enum support_ticket_status {
	open
	in_progress
	waiting_for_user
	resolved
	closed
}

enum support_ticket_source {
	web
	bot
}

enum review_target_type {
	project
	user
}

enum project_type {
	scientific
	practical
}

enum portfolio_work_type {
	scientific
	project
}

enum profile_credential_status {
	draft
	pending_review
	verified
	rejected
}

enum portfolio_item_status {
	draft
	pending_review
	verified
	rejected
}

Table user_account [headercolor: #175e7a] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	email varchar(320) [ not null, note: 'Обязательный email для входа, нормализован в нижний регистр' ]
	password_hash varchar(255) [ not null ]
	role system_role_code [ not null, default: 'client' ]
	status user_account_status [ not null, default: 'active' ]
	status_changed_by_user_id uuid
	status_changed_at timestamptz
	status_comment text
	last_login_at timestamptz
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(email) [ name: 'user_account_email_unique', unique ]
		(id, email) [ name: 'user_account_id_email_unique', unique ]
		(status) [ name: 'idx_user_account_status' ]
	}
}

Table user_email [headercolor: #175e7a] {
	user_id uuid [ pk, not null ]
	email varchar(320) [ not null, unique ]
	verified_at timestamptz [ not null, default: `now()` ]
}

Table registration_request [headercolor: #175e7a] {
	email varchar(320) [ pk, not null, note: 'Нормализованный email; заявка не резервирует аккаунт' ]
	password_hash varchar(255) [ not null ]
	token_hash char(64) [ not null, unique ]
	expires_at timestamptz [ not null ]
	created_at timestamptz [ not null, default: `now()` ]

	indexes {
		(expires_at) [ name: 'registration_expires_at_idx' ]
	}
}

Table trusted_email_domain [headercolor: #175e7a] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	domain varchar(255) [ not null, unique ]
	organization_name varchar(255) [ not null ]
	is_active boolean [ not null, default: true ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
}

Table user_profile [headercolor: #317256] {
	user_id uuid [ pk, not null ]
	schema_version integer [ not null, default: 1 ]
	data jsonb [ not null, default: '{}' ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
}

Table user_privacy_settings {
	user_id uuid [ pk, not null ]
	show_participating_projects boolean [ not null, default: false ]
	show_contacts boolean [ not null, default: false ]
	updated_at timestamptz [ not null, default: `now()` ]
}

Table user_block {
	blocker_user_id uuid [ not null ]
	blocked_user_id uuid [ not null ]
	created_at timestamptz [ not null, default: `now()` ]

	indexes {
		(blocker_user_id, blocked_user_id) [ pk, name: 'pk_user_block' ]
		(blocked_user_id) [ name: 'idx_user_block_blocked' ]
	}
}

Table profile_credential {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	user_id uuid [ not null ]
	title varchar(255) [ not null ]
	institution varchar(255) [ not null ]
	graduation_year integer
	evidence_file_url text
	status profile_credential_status [ not null, default: 'draft' ]
	moderated_by_user_id uuid
	moderated_at timestamptz
	moderation_comment text
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(user_id) [ name: 'idx_profile_credential_user' ]
		(status) [ name: 'idx_profile_credential_status' ]
	}
}

Table portfolio_item {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	user_id uuid [ not null ]
	type portfolio_work_type [ not null ]
	title varchar(255) [ not null ]
	description text [ not null ]
	url text
	evidence_file_url text
	status portfolio_item_status [ not null, default: 'draft' ]
	moderated_by_user_id uuid
	moderated_at timestamptz
	moderation_comment text
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(user_id) [ name: 'idx_portfolio_item_user' ]
		(status) [ name: 'idx_portfolio_item_status' ]
	}
}

Table project [headercolor: #317256] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	owner_user_id uuid [ not null ]
	title varchar(255) [ not null ]
	summary text
	type project_type [ not null ]
	field varchar(120) [ not null ]
	data jsonb [ not null, default: '{}' ]
	status project_status [ not null, default: 'draft' ]
	planned_start_date date
	planned_end_date date [ ]
	started_at timestamptz
	completed_at timestamptz
	published_at timestamptz
	moderated_by_user_id uuid
	moderated_at timestamptz
	moderation_comment text
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(owner_user_id) [ name: 'idx_project_owner' ]
		(status) [ name: 'idx_project_status' ]
	}
}

Table project_position [headercolor: #317256] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	project_id uuid [ not null ]
	title varchar(255) [ not null ]
	description text
	slots_count integer [ not null, default: 1 ]
	is_open boolean [ not null, default: true ]
	data jsonb [ not null, default: '{}' ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(project_id) [ name: 'idx_project_position_project' ]
	}
}

Table project_tag {
	project_id uuid [ not null ]
	tag varchar(100) [ not null ]

	indexes {
		(project_id, tag) [ pk, name: 'pk_project_tag' ]
		(tag) [ name: 'idx_project_tag_tag' ]
	}
}

Table project_position_skill {
	project_position_id uuid [ not null ]
	skill varchar(100) [ not null ]

	indexes {
		(project_position_id, skill) [ pk, name: 'pk_project_position_skill' ]
		(skill) [ name: 'idx_project_position_skill_skill' ]
	}
}

Table profile_skill {
	user_id uuid [ not null ]
	skill varchar(100) [ not null ]

	indexes {
		(user_id, skill) [ pk, name: 'pk_profile_skill' ]
		(skill) [ name: 'idx_profile_skill_skill' ]
	}
}

Table profile_interest {
	user_id uuid [ not null ]
	interest varchar(100) [ not null ]

	indexes {
		(user_id, interest) [ pk, name: 'pk_profile_interest' ]
		(interest) [ name: 'idx_profile_interest_interest' ]
	}
}

Table project_member [headercolor: #b07a32] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	project_id uuid [ not null ]
	user_id uuid [ not null ]
	project_position_id uuid
	status project_member_status [ not null, default: 'active' ]
	joined_at timestamptz [ not null, default: `now()` ]
	left_at timestamptz

	indexes {
		(project_id, user_id) [ name: 'uq_project_member_project_user', unique ]
		(user_id) [ name: 'idx_project_member_user' ]
		(project_position_id) [ name: 'idx_project_member_position' ]
	}
}

Table project_join_request [headercolor: #b07a32] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	project_position_id uuid [ not null ]
	candidate_user_id uuid [ not null ]
	type join_request_type [ not null ]
	status join_request_status [ not null, default: 'pending' ]
	initiated_by_user_id uuid [ not null ]
	message text
	responded_by_user_id uuid
	responded_at timestamptz
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(project_position_id, candidate_user_id) [ unique, name: 'uq_join_request_position_candidate' ]
		(candidate_user_id) [ name: 'idx_join_request_candidate' ]
	}
}

Table support_ticket [headercolor: #b56b45] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	author_user_id uuid [ not null ]
	assigned_user_id uuid
	type support_ticket_type [ not null ]
	status support_ticket_status [ not null, default: 'open' ]
	source support_ticket_source [ not null, default: 'web' ]
	subject varchar(255) [ not null ]
	description text [ not null ]
	target_user_id uuid [ ]
	target_project_id uuid
	resolution text
	feedback_rating integer [ ]
	feedback_comment text
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
	resolved_at timestamptz
	closed_at timestamptz

	indexes {
		(author_user_id) [ name: 'idx_support_ticket_author' ]
		(assigned_user_id) [ name: 'idx_support_ticket_assignee' ]
		(status) [ name: 'idx_support_ticket_status' ]
		(target_user_id) [ name: 'idx_support_ticket_target_user' ]
		(target_project_id) [ name: 'idx_support_ticket_target_project' ]
	}
}

Table chat_conversation {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	created_by_user_id uuid [ not null ]
	join_request_id uuid [ unique ]
	support_ticket_id uuid [ unique ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(created_by_user_id) [ name: 'idx_chat_conversation_creator' ]
	}
}

Table chat_participant {
	conversation_id uuid [ not null ]
	user_id uuid [ not null ]
	joined_at timestamptz [ not null, default: `now()` ]
	last_read_at timestamptz
	archived_at timestamptz

	indexes {
		(conversation_id, user_id) [ pk, name: 'pk_chat_participant' ]
		(user_id) [ name: 'idx_chat_participant_user' ]
	}
}

Table support_ticket_attachment {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	support_ticket_id uuid [ not null ]
	file_url text [ not null ]
	file_name varchar(255)
	content_type varchar(100)
	created_at timestamptz [ not null, default: `now()` ]

	indexes {
		(support_ticket_id) [ name: 'idx_support_ticket_attachment_ticket' ]
	}
}

Table message [headercolor: #5969a6] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	conversation_id uuid [ not null ]
	sender_user_id uuid [ not null ]
	body text [ not null ]
	attachments jsonb [ not null, default: '[]' ]
	created_at timestamptz [ not null, default: `now()` ]
	edited_at timestamptz
	deleted_at timestamptz

	indexes {
		(sender_user_id) [ name: 'idx_message_sender' ]
		(conversation_id, created_at) [ name: 'idx_message_conversation_created' ]
	}
}

Table notification [headercolor: #5969a6] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	user_id uuid [ not null ]
	type varchar(100) [ not null ]
	data jsonb [ not null, default: '{}' ]
	created_at timestamptz [ not null, default: `now()` ]
	read_at timestamptz

	indexes {
		(user_id) [ name: 'idx_notification_user' ]
		(user_id, read_at) [ name: 'idx_notification_user_read' ]
	}
}

Table review [headercolor: #5969a6] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	project_id uuid [ not null ]
	author_user_id uuid [ not null ]
	target_type review_target_type [ not null ]
	target_user_id uuid [ ]
	rating integer [ not null ]
	comment text
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(project_id) [ name: 'idx_review_project' ]
		(author_user_id) [ name: 'idx_review_author' ]
		(target_user_id) [ name: 'idx_review_target_user' ]
		(target_type, target_user_id) [ name: 'idx_review_target' ]
	}
}

Ref user_privacy_settings_user {
	user_privacy_settings.user_id - user_account.id [ delete: no action, update: no action ]
}

Ref user_block_blocker {
	user_block.blocker_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref user_block_blocked {
	user_block.blocked_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref profile_credential_user {
	profile_credential.user_id > user_account.id [ delete: no action, update: no action ]
}

Ref profile_credential_moderator {
	profile_credential.moderated_by_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref portfolio_item_user {
	portfolio_item.user_id > user_account.id [ delete: no action, update: no action ]
}

Ref portfolio_item_moderator {
	portfolio_item.moderated_by_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref chat_conversation_creator {
	chat_conversation.created_by_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref chat_conversation_join_request {
	chat_conversation.join_request_id - project_join_request.id [ delete: no action, update: no action ]
}

Ref chat_conversation_support_ticket {
	chat_conversation.support_ticket_id - support_ticket.id [ delete: no action, update: no action ]
}

Ref chat_participant_conversation {
	chat_participant.conversation_id > chat_conversation.id [ delete: no action, update: no action ]
}

Ref chat_participant_user {
	chat_participant.user_id > user_account.id [ delete: no action, update: no action ]
}

Ref support_ticket_attachment_ticket {
	support_ticket_attachment.support_ticket_id > support_ticket.id [ delete: no action, update: no action ]
}

Ref message_conversation {
	message.conversation_id > chat_conversation.id [ delete: no action, update: no action ]
}

Ref user_account_status_changed_by {
	user_account.status_changed_by_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref user_email_account {
	user_email.(user_id, email) - user_account.(id, email) [ delete: no action, update: no action ]
}


Ref user_profile_user {
	user_profile.user_id - user_account.id [ delete: no action, update: no action ]
}

Ref project_tag_project {
	project_tag.project_id > project.id [ delete: no action, update: no action ]
}

Ref project_position_skill_position {
	project_position_skill.project_position_id > project_position.id [ delete: no action, update: no action ]
}

Ref profile_skill_user {
	profile_skill.user_id > user_account.id [ delete: no action, update: no action ]
}

Ref profile_interest_user {
	profile_interest.user_id > user_account.id [ delete: no action, update: no action ]
}

Ref project_owner {
	project.owner_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref project_moderator {
	project.moderated_by_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref project_position_project {
	project_position.project_id > project.id [ delete: no action, update: no action ]
}

Ref project_member_project {
	project_member.project_id > project.id [ delete: no action, update: no action ]
}

Ref project_member_user {
	project_member.user_id > user_account.id [ delete: no action, update: no action ]
}

Ref project_member_position {
	project_member.project_position_id > project_position.id [ delete: no action, update: no action ]
}

Ref project_join_request_position {
	project_join_request.project_position_id > project_position.id [ delete: no action, update: no action ]
}

Ref project_join_request_candidate {
	project_join_request.candidate_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref project_join_request_initiator {
	project_join_request.initiated_by_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref project_join_request_responder {
	project_join_request.responded_by_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref support_ticket_author {
	support_ticket.author_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref support_ticket_assignee {
	support_ticket.assigned_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref support_ticket_target_user {
	support_ticket.target_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref support_ticket_target_project {
	support_ticket.target_project_id > project.id [ delete: no action, update: no action ]
}

Ref message_sender {
	message.sender_user_id > user_account.id [ delete: no action, update: no action ]
}



Ref notification_user {
	notification.user_id > user_account.id [ delete: no action, update: no action ]
}

Ref review_project {
	review.project_id > project.id [ delete: no action, update: no action ]
}

Ref review_author {
	review.author_user_id > user_account.id [ delete: no action, update: no action ]
}

Ref review_target_user {
	review.target_user_id > user_account.id [ delete: no action, update: no action ]
}
