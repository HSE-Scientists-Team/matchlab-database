enum user_account_status {
	active
	blocked
	deleted
}

enum system_role_code {
	client
	moderator
	administrator
}

enum project_status {
	draft
	pending_moderation
	recruiting
	active
	completed
	cancelled
	rejected
	hidden
}

enum project_member_status {
	active
	left
	removed
}

enum join_request_type {
	application
	invitation
}

enum join_request_status {
	pending
	accepted
	rejected
	cancelled
}

enum support.support_ticket_status {
	open
	resolved
	declined
}

enum review_target_type {
	project
	user
}

enum project_type {
	scientific
	practical
}

enum portfolio_work_type {
	scientific
	project
}

enum profile_credential_status {
	draft
	pending_review
	verified
	rejected
}

enum portfolio_item_status {
	draft
	pending_review
	verified
	rejected
}

Table users.user_account [headercolor: #175e7a] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	email varchar(320) [ not null, note: 'Обязательный email для входа, нормализован в нижний регистр' ]
	password_hash varchar(255) [ not null ]
	role system_role_code [ not null, default: 'client' ]
	status user_account_status [ not null, default: 'active' ]
	status_changed_by_user_id uuid
	status_changed_at timestamptz
	status_comment text
	last_login_at timestamptz
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(email) [ name: 'user_account_email_unique', unique ]
		(id, email) [ name: 'user_account_id_email_unique', unique ]
		(status) [ name: 'idx_user_account_status' ]
	}
}

Table users.user_email [headercolor: #175e7a] {
	user_id uuid [ pk, not null ]
	email varchar(320) [ not null, unique ]
	verified_at timestamptz [ not null, default: `now()` ]
}

Table users.registration_request [headercolor: #175e7a] {
	email varchar(320) [ pk, not null, note: 'Нормализованный email; заявка не резервирует аккаунт' ]
	password_hash varchar(255) [ not null ]
	token_hash char(64) [ not null, unique ]
	expires_at timestamptz [ not null ]
	created_at timestamptz [ not null, default: `now()` ]

	indexes {
		(expires_at) [ name: 'registration_expires_at_idx' ]
	}
}

Table users.trusted_email_domain [headercolor: #175e7a] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	domain varchar(255) [ not null, unique ]
	organization_name varchar(255) [ not null ]
	is_active boolean [ not null, default: true ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
}











Table project [headercolor: #317256] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	owner_user_id uuid [ not null ]
	title varchar(255) [ not null ]
	summary text
	type project_type [ not null ]
	field varchar(120) [ not null ]
	data jsonb [ not null, default: '{}' ]
	status project_status [ not null, default: 'draft' ]
	planned_start_date date
	planned_end_date date [ ]
	started_at timestamptz
	completed_at timestamptz
	published_at timestamptz
	moderated_by_user_id uuid
	moderated_at timestamptz
	moderation_comment text
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(owner_user_id) [ name: 'idx_project_owner' ]
		(status) [ name: 'idx_project_status' ]
	}
}

Table project_position [headercolor: #317256] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	project_id uuid [ not null ]
	title varchar(255) [ not null ]
	description text
	slots_count integer [ not null, default: 1 ]
	is_open boolean [ not null, default: true ]
	data jsonb [ not null, default: '{}' ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(project_id) [ name: 'idx_project_position_project' ]
	}
}

Table project_tag {
	project_id uuid [ not null ]
	tag varchar(100) [ not null ]

	indexes {
		(project_id, tag) [ pk, name: 'pk_project_tag' ]
		(tag) [ name: 'idx_project_tag_tag' ]
	}
}

Table project_position_skill {
	project_position_id uuid [ not null ]
	skill varchar(100) [ not null ]

	indexes {
		(project_position_id, skill) [ pk, name: 'pk_project_position_skill' ]
		(skill) [ name: 'idx_project_position_skill_skill' ]
	}
}





Table project_member [headercolor: #b07a32] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	project_id uuid [ not null ]
	user_id uuid [ not null ]
	project_position_id uuid
	status project_member_status [ not null, default: 'active' ]
	joined_at timestamptz [ not null, default: `now()` ]
	left_at timestamptz

	indexes {
		(project_id, user_id) [ name: 'uq_project_member_project_user', unique ]
		(user_id) [ name: 'idx_project_member_user' ]
		(project_position_id) [ name: 'idx_project_member_position' ]
	}
}

Table project_join_request [headercolor: #b07a32] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	project_position_id uuid [ not null ]
	candidate_user_id uuid [ not null ]
	type join_request_type [ not null ]
	status join_request_status [ not null, default: 'pending' ]
	initiated_by_user_id uuid [ not null ]
	message text
	responded_by_user_id uuid
	responded_at timestamptz
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(project_position_id, candidate_user_id) [ unique, name: 'uq_join_request_position_candidate' ]
		(candidate_user_id) [ name: 'idx_join_request_candidate' ]
	}
}

Table support.support_ticket [headercolor: #b56b45] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	author_user_id uuid [ not null, note: 'Идентификатор пользователя из User; межсервисного FK нет' ]
	assigned_user_id uuid [ note: 'Идентификатор сотрудника из User; межсервисного FK нет' ]
	status support.support_ticket_status [ not null, default: 'open' ]
	subject varchar(255) [ not null, note: 'Непустая строка после btrim' ]
	description text [ not null, note: 'Непустая строка после btrim' ]
	target_user_id uuid [ note: 'Идентификатор пользователя из User; ровно одна из двух целей заполнена' ]
	target_project_id uuid [ note: 'Идентификатор проекта; ровно одна из двух целей заполнена' ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
	resolved_at timestamptz

	indexes {
		(author_user_id) [ name: 'idx_support_ticket_author' ]
		(assigned_user_id) [ name: 'idx_support_ticket_assignee' ]
		(status) [ name: 'idx_support_ticket_status' ]
		(target_user_id) [ name: 'idx_support_ticket_target_user' ]
		(target_project_id) [ name: 'idx_support_ticket_target_project' ]
	}
}

Table chat_conversation {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	created_by_user_id uuid [ not null ]
	join_request_id uuid [ unique ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	indexes {
		(created_by_user_id) [ name: 'idx_chat_conversation_creator' ]
	}
}

Table chat_participant {
	conversation_id uuid [ not null ]
	user_id uuid [ not null ]
	joined_at timestamptz [ not null, default: `now()` ]
	last_read_at timestamptz
	archived_at timestamptz

	indexes {
		(conversation_id, user_id) [ pk, name: 'pk_chat_participant' ]
		(user_id) [ name: 'idx_chat_participant_user' ]
	}
}

Table support.support_ticket_attachment [headercolor: #b56b45] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	support_ticket_id uuid [ not null ]
	file_id uuid [ not null, note: 'Идентификатор файла из Media; межсервисного FK нет' ]

	indexes {
		(support_ticket_id, file_id) [ unique, name: 'support_ticket_attachment_file_unique' ]
		(support_ticket_id) [ name: 'idx_support_ticket_attachment_ticket' ]
	}
}

Table message [headercolor: #5969a6] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	conversation_id uuid [ not null ]
	sender_user_id uuid [ not null ]
	body text [ not null ]
	attachments jsonb [ not null, default: '[]' ]
	created_at timestamptz [ not null, default: `now()` ]
	edited_at timestamptz
	deleted_at timestamptz

	indexes {
		(sender_user_id) [ name: 'idx_message_sender' ]
		(conversation_id, created_at) [ name: 'idx_message_conversation_created' ]
	}
}

Table notification [headercolor: #5969a6] {
	id uuid [ pk, not null, default: `gen_random_uuid()` ]
	user_id uuid [ not null ]
	type varchar(100) [ not null ]
	data jsonb [ not null, default: '{}' ]
	created_at timestamptz [ not null, default: `now()` ]
	read_at timestamptz

	indexes {
		(user_id) [ name: 'idx_notification_user' ]
		(user_id, read_at) [ name: 'idx_notification_user_read' ]
	}
}

















Ref chat_conversation_creator {
	chat_conversation.created_by_user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref chat_conversation_join_request {
	chat_conversation.join_request_id - project_join_request.id [ delete: no action, update: no action ]
}

Ref chat_participant_conversation {
	chat_participant.conversation_id > chat_conversation.id [ delete: no action, update: no action ]
}

Ref chat_participant_user {
	chat_participant.user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref support_ticket_attachment_ticket {
	support.support_ticket_attachment.support_ticket_id > support.support_ticket.id [ delete: no action, update: no action ]
}

Ref message_conversation {
	message.conversation_id > chat_conversation.id [ delete: no action, update: no action ]
}

Ref user_account_status_changed_by {
	users.user_account.status_changed_by_user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref user_email_account {
	users.user_email.(user_id, email) - users.user_account.(id, email) [ delete: no action, update: no action ]
}




Ref project_tag_project {
	project_tag.project_id > project.id [ delete: no action, update: no action ]
}

Ref project_position_skill_position {
	project_position_skill.project_position_id > project_position.id [ delete: no action, update: no action ]
}





Ref project_owner {
	project.owner_user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref project_moderator {
	project.moderated_by_user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref project_position_project {
	project_position.project_id > project.id [ delete: no action, update: no action ]
}

Ref project_member_project {
	project_member.project_id > project.id [ delete: no action, update: no action ]
}

Ref project_member_user {
	project_member.user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref project_member_position {
	project_member.project_position_id > project_position.id [ delete: no action, update: no action ]
}

Ref project_join_request_position {
	project_join_request.project_position_id > project_position.id [ delete: no action, update: no action ]
}

Ref project_join_request_candidate {
	project_join_request.candidate_user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref project_join_request_initiator {
	project_join_request.initiated_by_user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref project_join_request_responder {
	project_join_request.responded_by_user_id > users.user_account.id [ delete: no action, update: no action ]
}

Ref message_sender {
	message.sender_user_id > users.user_account.id [ delete: no action, update: no action ]
}



Ref notification_user {
	notification.user_id > users.user_account.id [ delete: no action, update: no action ]
}







// Реализовано миграциями backend 00002 и 00003.
// owner_user_id — идентификатор User без межсервисного внешнего ключа.
Enum media.file_status {
  pending
  ready
  deleting [note: 'Внутреннее намерение удалить объект в S3 и зафиксировать результат в БД; не публичный API-статус']
  deleted
  failed
}

Table media.file [headercolor: #5969a6] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  owner_user_id uuid [not null]
  is_public boolean [not null, default: false]
  bucket_name varchar(63) [not null]
  object_key text [not null, note: 'Непустой ключ, не более 1024 байт']
  original_name varchar(255) [not null]
  content_type varchar(255) [not null]
  size_bytes bigint [note: 'NULL до подтверждения; иначе >= 0']
  expected_size_bytes bigint [note: 'NULL либо > 0']
  etag text
  checksum_sha256 char(64) [note: 'NULL либо 64 символа нижнего hexadecimal']
  status media.file_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  uploaded_at timestamptz
  deleted_at timestamptz
  indexes {
    (bucket_name, object_key) [unique, name: 'media_file_storage_location_unique']
    (owner_user_id, created_at) [name: 'media_file_owner_created_idx', note: 'created_at DESC']
    status [name: 'media_file_status_idx']
    (updated_at, id) [name: 'media_file_pending_updated_idx', note: "WHERE status = 'pending'"]
  }
  Note: 'Bucket, original_name и content_type непустые. Контент хранится в S3; публичность регулирует Media, bucket приватен.'
}

Table media.multipart_upload [headercolor: #5969a6] {
  file_id uuid [pk, not null, ref: > media.file.id]
  s3_upload_id text [not null, note: 'Непустой S3 upload ID']
  expected_size_bytes bigint [not null, note: '> 0; <= part_size_bytes * 10000']
  part_size_bytes bigint [not null, note: 'От 5242880 до 5368709120']
  status text [not null, default: 'uploading', note: 'uploading, completing, completed, aborted']
  completion_manifest jsonb [not null, default: `'[]'::jsonb`, note: 'JSON-массив частей для повторного завершения']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: '> created_at']
  indexes {
    expires_at [name: 'media_multipart_recovery_idx', note: "WHERE status IN ('uploading', 'completing')"]
  }
}

// KAN-38 — backend migration 00005. JSONB contains typed profile/achievement fields.
Table users.user_profile {
  user_id uuid [pk, not null, ref: > users.user_account.id]
  data jsonb [not null, default: `'{}'::jsonb`, note: 'display_name, avatar_file_id, university, study_level, study_year, specialization, about, open_to_collaboration, project_types, interests, skills, contact_email, telegram']
  show_contacts boolean [not null, default: false]
  show_participating_projects boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Automatically initialized for each account. GIN indexes on data.skills and data.interests. Verified badge is computed from confirmed exact hse.ru/edu.hse.ru email.'
}
Table users.achievement {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_account.id]
  kind text [not null, note: 'education/certificate/scientific/project']
  data jsonb [not null, note: 'Typed title, description, institution, graduation_year and URL; owner edits reset verification']
  evidence_file_id uuid [note: 'Media identifier without cross-service FK; proof must be private and ready']
  status text [not null, default: 'unverified', note: 'unverified/pending_review/verified/needs_evidence']
  revision integer [not null, default: 1, note: '> 0; optimistic concurrency']
  moderation_comment text [not null, default: '']
  submitted_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, created_at, id) [name: 'achievement_owner']
    (submitted_at, id) [name: 'achievement_queue', note: "WHERE status='pending_review'"]
  }
}
Table users.achievement_decision {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  achievement_id uuid [not null, ref: > users.achievement.id]
  revision integer [not null]
  reviewer_user_id uuid [not null, ref: > users.user_account.id]
  approved boolean [not null]
  reviewed_data jsonb [not null, note: 'Snapshot of the reviewed revision']
  evidence_file_id uuid
  comment text [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { (achievement_id, revision) [unique] }
}
Table users.user_block {
  blocker_user_id uuid [not null, ref: > users.user_account.id]
  blocked_user_id uuid [not null, ref: > users.user_account.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (blocker_user_id, blocked_user_id) [pk]
    (blocked_user_id, blocker_user_id) [name: 'user_block_reverse']
  }
  Note: 'No self-blocks. Messages/invitations check either direction; memberships are preserved.'
}
Table users.project_context {
  project_id uuid [pk, not null, note: 'Identifier owned by future Projects; no cross-service FK']
  title varchar(255) [not null]
  initiator_user_id uuid [not null, ref: > users.user_account.id]
  completed_at timestamptz [note: 'NULL: current team; otherwise immutable completed snapshot for reviews']
}
Table users.project_context_member {
  project_id uuid [not null, ref: > users.project_context.project_id]
  user_id uuid [not null, ref: > users.user_account.id]
  indexes {
    (project_id, user_id) [pk]
    (user_id, project_id) [name: 'project_context_user']
  }
}
Table users.profile_review {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > users.project_context.project_id]
  author_user_id uuid [not null, ref: > users.user_account.id]
  target_user_id uuid [not null, ref: > users.user_account.id]
  title varchar(255) [not null]
  text text [not null]
  rating integer [not null, note: '1–5']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (project_id, author_user_id, target_user_id) [unique]
    (target_user_id, created_at, id) [name: 'profile_review_target']
  }
  Note: 'Author and target must belong to completed project; no self-review.'
}
Ref: users.profile_review.(project_id,author_user_id) > users.project_context_member.(project_id,user_id)
Ref: users.profile_review.(project_id,target_user_id) > users.project_context_member.(project_id,user_id)
